# Copy to .env on the production server (never commit the real file).
# In local development this file is optional — sensible defaults are baked
# into hatchery/settings/dev.py.

# ─── Environment ──────────────────────────────────────────────────────────────
# Tells build.sh / redeploy.sh which Django settings module to activate.
# production → hatchery.settings.prod  |  development → hatchery.settings.dev
DJANGO_ENV=production

# ─── Django core ──────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=hatchery.islan.dev

# ─── Database ─────────────────────────────────────────────────────────────────
# Component variables shown for readability — assemble them into DATABASE_URL.
# DATABASE_URL is the variable Django actually reads (via django-environ).
DB_NAME=hatchery
DB_USER=hatchery
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://hatchery:replace-with-a-strong-password@localhost:5432/hatchery

# ─── Security — SSL, cookies, HSTS ────────────────────────────────────────────
# The values below match the prod.py defaults and are already production-safe.
# Only override here if you need to temporarily change a value for debugging.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
# Systemd service name. build.sh and redeploy.sh restart this service.
# Give each Django app on this server a unique name.
GUNICORN_SERVICE_NAME=gunicorn-hatchery
