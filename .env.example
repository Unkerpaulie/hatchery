# Copy to .env on the production server (never commit the real file).
# In local development this file is optional \u2014 sensible defaults are baked
# into hatchery/settings/dev.py.

DEBUG=False
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=example.com,www.example.com

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://hatchery:changeme@localhost:5432/hatchery
